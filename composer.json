{
    "name": "patrick-fischer/html-plucker",
    "description": "A modern, read-focused HTML scraping library for PHP 8.4+ built on Dom\\HTMLDocument.",
    "keywords": ["html", "scraping", "dom", "parser", "css-selector"],
    "license": "MIT",
    "authors": [
        {
            "name": "Patrick Fischer",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "guzzlehttp/guzzle": "^8.0",
        "guzzlehttp/psr7": "^3.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "HtmlPlucker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HtmlPlucker\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
